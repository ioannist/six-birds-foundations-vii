{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://six-birds.local/schemas/countermodel.schema.json",
  "title": "Foundations VII Step-3 Countermodel Record",
  "type": "object",
  "required": ["countermodel_id", "name", "scenario_id", "shows", "candidate_ids", "escape_route"],
  "properties": {
    "countermodel_id": {"type": "string", "pattern": "^CM-[0-9]{2}$"},
    "name": {"type": "string", "minLength": 3},
    "scenario_id": {"type": "string", "pattern": "^TTW-S[0-9]{2}$"},
    "shows": {"type": "string", "minLength": 3},
    "candidate_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^VII-C[0-9]{3}$"}
    },
    "escape_route": {"type": "string", "minLength": 3}
  },
  "additionalProperties": true
}
