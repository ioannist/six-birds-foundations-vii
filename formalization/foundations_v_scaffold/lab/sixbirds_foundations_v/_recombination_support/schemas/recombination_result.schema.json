            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Robustness Fraction"
        },
        "status": {
          "$ref": "#/$defs/RobustnessStatus"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "trial_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trial Count"
        }
      },
      "required": [
        "status",
        "evidence_summary"
      ],
      "title": "RobustnessSummary",
      "type": "object"
    },
