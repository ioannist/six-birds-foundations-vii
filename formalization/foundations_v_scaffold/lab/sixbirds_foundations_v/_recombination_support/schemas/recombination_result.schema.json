          ],
          "default": null,
          "title": "Route Labels Marked"
        },
        "status": {
          "$ref": "#/$defs/AuditStatus"
        }
      },
      "required": [
        "status",
        "evidence_summary"
      ],
      "title": "RouteAuditSummary",
      "type": "object"
    },
