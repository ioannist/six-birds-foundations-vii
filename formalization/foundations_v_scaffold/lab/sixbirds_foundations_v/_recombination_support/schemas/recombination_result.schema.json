  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "derived_note_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Derived Note Path"
    },
    "manifest_id": {
      "title": "Manifest Id",
      "type": "string"
    },
    "raw_artifact_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Artifact Path"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/RecombinationInterfaceResultRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/RecombinationResultManifestVersion",
      "default": "recombination-result-manifest.v1"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
