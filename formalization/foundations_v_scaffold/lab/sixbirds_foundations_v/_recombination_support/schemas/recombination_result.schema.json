{
  "$defs": {
    "AuditStatus": {
      "enum": [
        "passed",
        "failed",
        "inconclusive",
        "skipped"
      ],
      "title": "AuditStatus",
      "type": "string"
    },
    "FactorizationCertificateSummary": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        },
        "certificate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certificate Id"
        },
        "eta_surjective": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eta Surjective"
        },
        "evidence_summary": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Summary",
          "type": "array"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "failure_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Detail"
        },
        "status": {
          "$ref": "#/$defs/AuditStatus"
        }
      },
      "required": [
        "status",
        "evidence_summary"
      ],
      "title": "FactorizationCertificateSummary",
      "type": "object"
    },
    "FlatteningAuditSummary": {
