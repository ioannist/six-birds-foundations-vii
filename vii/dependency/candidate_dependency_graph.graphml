 key="k1">Independent behavior without source independence</data></node><node id="TTW-S12"><data key="k0">finite_scenario</data><data key="k1">Compatible interfaces but no witnessed contact</data></node><node id="TTW-S13"><data key="k0">finite_scenario</data><data key="k1">Coverage-qualified certified non-interaction</data></node><node id="TTW-S14"><data key="k0">finite_scenario</data><data key="k1">Scheduling artifact masquerades as novelty</data></node><node id="TTW-S15"><data key="k0">finite_scenario</data><data key="k1">Relabeling masquerades as novelty</data></node><node id="TTW-S16"><data key="k0">finite_scenario</data><data key="k1">Three-theory order residue</data></node><node id="TTW-S17"><data key="k0">finite_scenario</data><data key="k1">Holonomy with zero arrow</data></node><node id="TTW-S18"><data key="k0">finite_scenario</data><data key="k1">Driven arrow control</data></node><node id="TTW-S19"><data key="k0">finite_scenario</data><data key="k1">Sound rule that is unreachable</data></node><node id="TTW-S20"><data key="k0">finite_scenario</data><data key="k1">Reachable admission that does not occur</data></node><node id="TTW-S21"><data key="k0">finite_scenario</data><data key="k1">Reachable and occurrent admission</data></node><node id="TTW-S22"><data key="k0">finite_scenario</data><data key="k1">Unpriced observer occupancy</data></node><node id="TTW-S23"><data key="k0">finite_scenario</data><data key="k1">Total-lens theorem applied to partial domain</data></node><node id="TTW-S24"><data key="k0">finite_scenario</data><data key="k1">Parent refinement changes join and residual</data></node><node id="VII-C001"><data key="k0">candidate</data><data key="k1">Accessible-domain state normal form</data></node><node id="VII-C002"><data key="k0">candidate</data><data key="k1">Lawful admission transition system</data></node><node id="VII-C003"><data key="k0">candidate</data><data key="k1">Bootstrap obstruction theorem</data></node><node id="VII-C004"><data key="k0"